# Safe default: alerts are logged to the DB/dashboard but NOT sent. Set to false to go live.
PAPER_MODE=true

PORT=8787
DB_PATH=./data/bot.db
# Leave empty for no dashboard password (LAN only!). Username is ignored.
DASHBOARD_PASSWORD=

# Telegram: create a bot with @BotFather; get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: Channel settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=

# Strategy defaults (per-coin overrides are available in the dashboard)
SENSITIVITY=balanced
USE_KILLZONE=true
WATCH_DISTANCE_ATR=1.0
MAX_BARS_AFTER_TAP=25
